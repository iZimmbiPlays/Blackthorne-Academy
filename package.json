{
  "name": "blackthorne_academy_git",
  "version": "1.0.0",
  "description": "**A custom-built virtual academy, learning management, and community platform developed from the ground up with PHP and MySQL.**",
  "main": "index.js",
  "scripts": {
    "format:php": "powershell -ExecutionPolicy Bypass -File ./beautify-php.ps1 all",
    "format:php:root": "powershell -ExecutionPolicy Bypass -File ./beautify-php.ps1 root",
    "format:php:admin": "powershell -ExecutionPolicy Bypass -File ./beautify-php.ps1 admin",
    "format:php:includes": "powershell -ExecutionPolicy Bypass -File ./beautify-php.ps1 includes",
    "format:assets": "prettier --write \"assets/**/*.css\" \"assets/**/*.js\"",
    "check:assets": "prettier --check \"assets/**/*.css\" \"assets/**/*.js\""
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iZimmbiPlays/Blackthorne-Academy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/iZimmbiPlays/Blackthorne-Academy/issues"
  },
  "homepage": "https://github.com/iZimmbiPlays/Blackthorne-Academy#readme",
  "devDependencies": {
    "@prettier/plugin-php": "^0.25.0",
    "js-beautify": "^2.0.3",
    "prettier": "^3.9.9"
  }
}
